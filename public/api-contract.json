    "/api/responses": {
      "post": {
        "operationId": "submitDailyResponse",
        "summary": "Submit one response for the current UTC day",
        "security": [
          {
            "MemberSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "enrollments",
                  "confirmations",
                  "calls"
                ],
                "properties": {
                  "enrollments": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "confirmations": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "calls": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Computed score and UTC date"
          },
          "400": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Already submitted for this UTC day"
          },
          "503": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ResourceInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "description",
          "category",
          "url",
          "scheduledAt"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "training",
              "session",
              "recording",
              "ebook"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          },
          "category": {
            "type": "string",
            "description": "Must match the selected type. See x-resource-categories."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://",
            "maxLength": 2000
          },
          "scheduledAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "MemberSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "platform-managed",
        "description": "Sites dispatch-managed sign-in; the API trusts only identity injected by the hosting platform."
      },
      "AdminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mp_admin",
        "description": "HttpOnly, SameSite=Strict, secure in HTTPS; expires after 8 hours."
      }
    }
  },
  "x-resource-categories": {
    "training": [
      "Minimum Billings",
      "Combo",
      "Skill Trainings",
      "Achievers"
    ],
    "session": [
      "Personal Meeting",
      "One-to-One Meeting",
      "Achievers Club Meetings"
    ],
    "recording": [
      "One-to-One Meeting",
      "Achievers Club",
      "Training Replay"
    ],
    "ebook": [
      "Personal Books",
      "E-Books"
    ]
  }
}
